# Bitrix24 OAuth2 credentials
BITRIX24_CLIENT_ID=your_client_id_here
BITRIX24_CLIENT_SECRET=your_client_secret_here
BITRIX24_REDIRECT_URI=https://your-domain.com/oauth/callback

# Bitrix24 webhook configuration
BITRIX24_WEBHOOK_SECRET=your_webhook_secret_here
BITRIX24_WEBHOOK_URL=https://your-domain.com/webhooks/bitrix24

# Token rotation
TOKEN_ROTATION_INTERVAL_DAYS=90
TOKEN_ENCRYPTION_KEY=your_encryption_key_here

# Sync configuration
SYNC_INTERVAL_MINUTES=15
SYNC_BATCH_SIZE=100
SYNC_CONFLICT_STRATEGY=manual_review

# Logging
LOG_LEVEL=INFO
AUDIT_LOG_PATH=/var/log/jol-bitrix24/audit.log
PII_LOGGING_ENABLED=false

# Database (for sync state and retry queue)
DATABASE_URL=postgresql://user:password@localhost:5432/jol_bitrix24
